# Database (MySQL 8.4)
ALUCO_DB_URL=jdbc:mysql://localhost:3306/aluco?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
ALUCO_DB_USER=root
ALUCO_DB_PASSWORD=123456

# JWT Configuration
ALUCO_JWT_SECRET=aluco-dev-secret-change-me-in-production-0123456789abcdef

# MQTT (HiveMQ / EMQX)
ALUCO_MQTT_BROKER=tcp://localhost:1883
ALUCO_MQTT_CLIENT_ID=aluco-server
ALUCO_MQTT_RECONNECT_MS=5000
ALUCO_MQTT_ENABLED=false

# Sink & Store Configuration
ALUCO_SINK_CAPACITY=50000
ALUCO_BATCH_MAX_SIZE=1000
ALUCO_BATCH_FLUSH_MS=500
ALUCO_STORE_STATE=mysql
ALUCO_STORE_TIMESERIES=mysql

# Offline Detection
ALUCO_OFFLINE_CHECK_ENABLED=true
ALUCO_OFFLINE_THRESHOLD_SECONDS=60
ALUCO_OFFLINE_CHECK_MS=15000

# Command (v2)
ALUCO_COMMAND_ENABLED=true
ALUCO_COMMAND_TIMEOUT_SECONDS=30
ALUCO_COMMAND_CHECK_INTERVAL_MS=10000

# EMQX API
ALUCO_EMQX_API_BASE=http://localhost:18083
ALUCO_EMQX_API_USER=admin
ALUCO_EMQX_API_PASSWORD=public

# Server Port
SERVER_PORT=8080